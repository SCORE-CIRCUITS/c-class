##GPIO Header J3
##J3.3 (F12)
set_property -quiet PACKAGE_PIN M39 [get_ports {io7_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io7_cell]
##J3.4 (G13)
set_property -quiet PACKAGE_PIN L41 [get_ports {io8_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io8_cell]
##J3.5 (D14)
set_property -quiet PACKAGE_PIN H42 [get_ports {io9_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io9_cell]
##J3.6 (H16)
set_property -quiet PACKAGE_PIN K40 [get_ports {io10_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io10_cell]
##J3.7 (D16)
set_property -quiet PACKAGE_PIN H41 [get_ports {io12_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io12_cell]
##J3.8 (H8)
set_property -quiet PACKAGE_PIN V40 [get_ports {io13_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io13_cell]
##J3.9 (F8)
set_property -quiet PACKAGE_PIN R40 [get_ports {io16_cell}]
set_property IOSTANDARD LVCMOS15 [get_ports io16_cell]

#PMOD J5
#PMOD0_0 (J2.1) CS (H10)
set_property PACKAGE_PIN R41     [get_ports  {io17_cell}] 
set_property IOSTANDARD  LVCMOS15 [get_ports {io17_cell}]
set_property PULLUP true [get_ports {io17_cell}] 

#PMOD0_1 (J5.2) MOSI (C11)
set_property PACKAGE_PIN A39      [get_ports {io18_cell}]  
set_property IOSTANDARD  LVCMOS15 [get_ports {io18_cell}] 
set_property PULLUP true [get_ports {io18_cell}] 

#PMOD0_2 (J5.3) SCK (H12)
set_property PACKAGE_PIN P40     [get_ports {io20_cell}] 
set_property IOSTANDARD  LVCMOS15 [get_ports {io20_cell}] 
set_property PULLUP true [get_ports {io20_cell}]

#PMOD0_3 (J5.4) MISO (E13)
set_property PACKAGE_PIN L39      [get_ports {io19_cell}] 
set_property IOSTANDARD  LVCMOS15 [get_ports {io19_cell}] 
set_property PULLUP true [get_ports {io19_cell}] 


##JTAG
##J2.3
set_property -quiet PACKAGE_PIN Y40 [get_ports {pin_trst}]
set_property IOSTANDARD LVCMOS15 [get_ports pin_trst]
set_property PULLDOWN true [get_ports pin_trst]
##J2.4
set_property -quiet PACKAGE_PIN U39 [get_ports {pin_tdi}]
set_property IOSTANDARD LVCMOS15 [get_ports pin_tdi]
##J2.5
set_property -quiet PACKAGE_PIN W40 [get_ports {pin_tms}]
set_property IOSTANDARD LVCMOS15 [get_ports pin_tms]
set_property PULLUP true [get_ports pin_tms]
##J2.6
set_property -quiet PACKAGE_PIN T39 [get_ports {pin_tck}]
set_property IOSTANDARD LVCMOS15 [get_ports pin_tck]
#create_clock -add -name tck_pin -period 100.00 -waveform {0 50} [get_ports {pin_tck}];
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets pin_tck_IBUF] 
##J2.7
set_property -quiet PACKAGE_PIN U41 [get_ports {pin_tdo}]
set_property IOSTANDARD LVCMOS15 [get_ports pin_tdo]


##general
set_property PACKAGE_PIN B41 [get_ports uart0_SOUT]
set_property PACKAGE_PIN B42 [get_ports uart0_SIN]
set_property IOSTANDARD LVCMOS15 [get_ports uart0*]

